PORT=4000
MONGODB_URI=mongodb://localhost:27017/claimcheck
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API in production (for example 1 behind a load balancer). 0 when reached directly.
TRUST_PROXY_HOPS=0

# Gemini (free tier: use synthetic bills only)
GEMINI_API_KEY=
# Models to try in order. If one is overloaded (503) or out of quota (429), the next one is used.
# Run `npm run gemini:models` to see which model IDs your key can use.
GEMINI_MODELS=gemini-3-flash-preview,gemini-2.5-flash

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Pricing heuristic: flag charges above this multiple of the Medicare benchmark
BENCHMARK_MULTIPLIER=3
